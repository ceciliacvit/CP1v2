function find_circles(scanSub,cmdPub)

    run_speed = 0.3;
    scan_speed = 0.05;

    cmdMsg = ros2message('geometry_msgs/Twist');
    cmdMsg.angular.z = -run_speed; % 0.5
    send(cmdPub,cmdMsg)

    circles = [];
    running = true;


    Detects = [];




    prev_found_circle = false;
    recent = [];
    orange_circle_found = false;
    blue_circle_found = false;

    while running

        circle = detectCircle(0.75);
        sum = 0;
        Detects(end+1) = circle.found;


        if numel(Detects) > 10
            recent = Detects(end-9:end);

            for i=recent
                if(i)
                sum = sum + 1;
                else
                sum = sum + 0;
                end
            end
        end
        
        if(circle.found)
            if(circle.color == "blue")
                if(blue_circle_found)
                    continue;
                end
            end

            if(circle.color == "orange")
                if(orange_circle_found)
                    continue;
                end
            end

            if(~prev_found_circle)
            cmdMsg.angular.z = -scan_speed;
            send(cmdPub,cmdMsg)
            end


            if(sum > 3)
                prev_found_circle = true;
                cmdMsg.angular.z = 0;
                send(cmdPub,cmdMsg)
                circle.color
                if(circle.color == "orange")
                    orange_circle_found = true;
                    disp("orange found")
                elseif (circle.color == "blue")
                    blue_circle_found = true;
                    disp("blue found")
                end
                while true
                    circle = detectCircle(0.7);
                    if(circle.distance > 1.1)
                        cmdMsg.linear.x = 0.1;
                    elseif (circle.distance < 0.9)
                        cmdMsg.linear.x = -0.1;
                    else
                        
                        cmdMsg.linear.x = 0.0;
                        send(cmdPub,cmdMsg)
                        captureImage();
                        break
                    end
                    send(cmdPub,cmdMsg)
                end
            end
            cmdMsg.angular.z = -run_speed;
            send(cmdPub,cmdMsg);


        end

        if(~circle.found)
            if(prev_found_circle)
               
            cmdMsg.angular.z = -run_speed; % -0.5
            send(cmdPub,cmdMsg)
            end
        end

        prev_found_circle = false;

        pause(0.01);
    end
    

end